{
  "name": "tektronix-oscilloscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser control panel for the Tektronix TBS1072B-EDU oscilloscope over WebUSB/USBTMC",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
